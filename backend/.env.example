# ===================================
# CipherBallot Backend Configuration
# ===================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cipherballot

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Google OAuth (College SSO)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# College Email Domain (restrict SSO to this domain)
ALLOWED_EMAIL_DOMAIN=college.edu

# Frontend URL (for CORS & OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Upload Directory
UPLOAD_DIR=uploads
